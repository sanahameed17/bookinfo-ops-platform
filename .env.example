# Copy this file to .env and fill in your values.  NEVER commit .env to Git.
#   PowerShell:  Copy-Item .env.example .env

# ---------------- Kubernetes ----------------
# Phase 1 finding: the cluster is Docker Desktop's built-in Kubernetes -> context "docker-desktop"
K8S_CONTEXT=docker-desktop
K8S_NAMESPACE=bookinfo
K8S_IN_CLUSTER=false

# ---------------- Prometheus ----------------
# kubectl port-forward -n monitoring svc/prometheus-operator-kube-p-prometheus 9091:9090
PROMETHEUS_URL=http://127.0.0.1:9091
PROMETHEUS_TIMEOUT_SECONDS=8
PROMETHEUS_RATE_WINDOW=2m
# false = ignore the Windows/Clash system proxy for Prometheus and Jaeger (localhost)
PROMETHEUS_USE_SYSTEM_PROXY=false

# ---------------- Jaeger (optional, for service dependencies) ----------------
# kubectl port-forward -n istio-system svc/tracing 16686:80
JAEGER_URL=http://127.0.0.1:16686/jaeger

# ---------------- Anomaly thresholds ----------------
CPU_THRESHOLD_CORES=0.1
MEMORY_THRESHOLD_MIB=400

# ---------------- AI OpsAgent (any OpenAI-compatible provider) ----------------
# DeepSeek (as in Lab 3):   LLM_BASE_URL=https://api.deepseek.com          LLM_MODEL=deepseek-chat
# Zhipu GLM:                LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/  LLM_MODEL=glm-4-flash
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ITERATIONS=8

# ---------------- Backend ----------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
